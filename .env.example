# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev only (ignored when NODE_ENV=production): makes a verified run's named
# gate fail synthetically for its first N attempts, to test the repair and
# needs_user paths by hand. Example: VERIFY_DEBUG_FAIL=policy:2
VERIFY_DEBUG_FAIL=
# Dev only (ignored when NODE_ENV=production): throws from the first changed
# screen of a verified run, to prove the render gate blocks it.
VERIFY_DEBUG_INJECT=

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Better Auth Credentials
BETTER_AUTH_SECRET=generate-a-32-character-random-key
BETTER_AUTH_URL=http://localhost:3000

# AI agent (OpenAI Agents SDK over an OpenAI-compatible gateway; Chat Completions only).
# AI_MODEL must be a model id the gateway actually serves (check GET {AI_BASE_URL}/models).
AI_BASE_URL=https://your-gateway.example.com/v1
AI_API_KEY=your-api-key
AI_MODEL=provider/model-name

# Optional: a faster, high-throughput model for support work (themes + data,
# code fixes, edits). Screens and planning keep AI_MODEL. Defaults to AI_MODEL.
AI_MODEL_FAST=
# Optional: the coder model (writes ChangeSets through the change gateway).
# Defaults to AI_MODEL. Recommended: a small, fast model such as
# anthropic/claude-haiku-5.5.
AI_MODEL_CODER=
# Optional: how many screens are built at the same time after the first (1-6, default 3).
AI_SCREEN_CONCURRENCY=3
# Optional: hidden reasoning before the model answers (none | minimal | low | medium | high, default low).
# Reasoning tokens are billed and slow down every call; "none" is fastest.
AI_REASONING_EFFORT=low

# Job queue (backend/src/services/jobs; Cloudhike Jobs today): agent runs (planning,
# screen generation, edits) execute in a worker the queue calls at POST {JOBS_WORKER_URL}/api/jobs/agent. Progress streams
# to the browser through the agent_events table (run `npm run db:sql` once).
JOBS_API_URL=
JOBS_API_KEY=
# Public base URL Cloudhike can reach (it refuses localhost). Defaults to NEXT_PUBLIC_APP_URL.
JOBS_WORKER_URL=
# How long Cloudhike waits for one run: up to 300 on Free, 3600 on Pro.
JOBS_TIMEOUT_SECONDS=300
# unset (default: the queue when configured with a public URL, else in-process) | queue | inline
AGENT_RUNNER=

# Encrypts stored secrets at rest: provider tokens, app backend credentials, GitHub tokens
# (32 random bytes: `openssl rand -base64 32`). Changing it makes stored connections
# unreadable, so creators would connect again. The old name CLOUDHIKE_ENCRYPTION_KEY is still read.
SECRETS_ENCRYPTION_KEY=

# CloudHike backend provider: lets creators connect their own CloudHike account so the
# agent can deploy a backend (Database, Auth, Storage, Email, Jobs) for their app.
# Register a developer app at cloudhike.dev → Settings → API & apps → Developer apps,
# with this callback URL: {NEXT_PUBLIC_APP_URL}/api/backend-providers/cloudhike/callback
# (it used to be /api/cloudhike/callback: update the registered URL, or set CLOUDHIKE_REDIRECT_URI).
CLOUDHIKE_CLIENT_ID=cha_your_client_id
CLOUDHIKE_CLIENT_SECRET=chs_your_client_secret
# Optional: override the callback URL (must match a registered one exactly).
CLOUDHIKE_REDIRECT_URI=

# ImageKit AI Image & Transformation Integration (editor's background removal
# / AI-transform / "Generate AI Image" tools — unrelated to seed image fill below)
# Documentation: https://imagekit.io/docs/image-transformation
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Seed image library: lib/agent/seed-images.ts fills blank seed "image" fields.
# It matches against curated ImageKit photos stored in Postgres (db/sql/image-library.sql,
# applied via `npm run db:sql`). Curated manifests can be imported via `npm run seed:images`.
# Unmatched queries record misses in image_library_misses and fall back to Picsum
# (lib/stock-images/index.ts, free, keyless) as a last-resort fallback so images are never blank.

# GitHub Export: lets creators export and push their generated Expo project directly to GitHub.
# Register an OAuth app on GitHub (Settings → Developer settings → OAuth Apps),
# with callback URL: {NEXT_PUBLIC_APP_URL}/api/github/callback
# Uses SECRETS_ENCRYPTION_KEY to encrypt tokens at rest (no new encryption key required).
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Optional: override the callback URL (must match the registered GitHub callback URL exactly).
GITHUB_REDIRECT_URI=

# Publish / EAS Builds: signs webhook callbacks from GitHub Actions reporting build status.
# Generate with: openssl rand -hex 32
PUBLISH_WEBHOOK_SECRET=your_publish_webhook_secret_here
# Optional: override the webhook URL sent to GitHub Actions (useful for tunneling in local dev, e.g. ngrok).
# Defaults to: {NEXT_PUBLIC_APP_URL}/api/publish/webhook
PUBLISH_WEBHOOK_URL=

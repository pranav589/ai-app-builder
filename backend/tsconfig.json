{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@/db": ["./db"],
      "@/db/*": ["./db/*"],
      "@/lib/*": ["./src/services/*"],
      "@app/shared/*": ["../shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "db/**/*.ts",
    "scripts/**/*.ts",
    "eval/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

{
  "name": "type-bundle",
  "version": "1.0.0",
  "private": true,
  "description": "Vendored, pinned copies of every package a generated app may import (lib/app-project/project.ts ALLOWED_PACKAGES), at the exact versions lib/app-project/templates.ts packageJson ships. Installed with `npm run typebundle:install`. lib/verify/gates/typecheck.ts resolves modules only from here, never from the app's own node_modules, so the check is pinned to Expo SDK 58 regardless of what else is installed at the repo root.",
  "dependencies": {
    "expo": "~58.0.25",
    "expo-router": "~58.0.31",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "zustand": "^5.1.0",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-glass-effect": "~58.0.5",
    "expo-linear-gradient": "~58.0.4",
    "expo-blur": "~58.0.6",
    "expo-image": "~58.0.18",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.22",
    "expo-local-authentication": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-clipboard": "~58.0.4",
    "expo-sharing": "~58.0.23",
    "expo-linking": "~58.0.17",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-splash-screen": "~58.0.14",
    "@types/react": "~19.3.0"
  }
}

# Backend environment configuration
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
DIRECT_URL=postgresql://user:password@host:port/database?sslmode=require

# Builder sign-in (identity provider, backend/src/services/identity; CloudHike Auth today)
AUTH_URL=https://cloudhike.dev/api/auth-service/your_app
AUTH_PUBLISHABLE_KEY=your_publishable_key
AUTH_SECRET_KEY=your_secret_key

# S3 Storage
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=your_bucket
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# Encrypts stored secrets (provider tokens, app credentials, GitHub tokens).
# CLOUDHIKE_ENCRYPTION_KEY is still read when this is unset.
SECRETS_ENCRYPTION_KEY=your_32_byte_base64_key

# CloudHike backend provider (creators' apps). Callback: {NEXT_PUBLIC_APP_URL}/api/backend-providers/cloudhike/callback
CLOUDHIKE_CLIENT_ID=your_client_id
CLOUDHIKE_CLIENT_SECRET=your_client_secret

# ImageKit AI Image & Transformation
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Publish Webhooks
PUBLISH_WEBHOOK_SECRET=your_webhook_secret

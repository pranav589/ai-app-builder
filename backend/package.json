{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node dist/index.js",
    "lint": "eslint --config ../eslint.config.mjs .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:sql": "node --env-file=.env scripts/migrate-sql.mjs"
  },
  "dependencies": {
    "@app/shared": "*",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@openai/agents": "^0.22.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/multer": "^2.3.0",
    "better-auth": "^1.1.18",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "form-data": "^4.0.6",
    "jszip": "^3.10.2",
    "libsodium-wrappers": "^0.8.4",
    "multer": "^1.4.5-lts.1",
    "openai": "^7.57.0",
    "postgres": "^3.4.5",
    "sucrase": "^3.35.0",
    "typescript": "^5.9.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}

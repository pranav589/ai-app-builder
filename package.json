{
  "name": "ai-app-builder",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n \"front,back,preview\" -c \"cyan,magenta,yellow\" \"npm --workspace=frontend run dev\" \"npm --workspace=backend run dev\" \"npm --workspace=frontend run watch:preview\"",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "test": "npm --workspace=shared test && npm --workspace=backend test && npm --workspace=frontend test",
    "test:backend": "npm --workspace=backend test",
    "test:shared": "npm --workspace=shared test",
    "test:frontend": "npm --workspace=frontend test",
    "lint": "eslint .",
    "db:generate": "npm --workspace=backend run db:generate",
    "db:push": "npm --workspace=backend run db:push",
    "db:studio": "npm --workspace=backend run db:studio",
    "db:sql": "npm --workspace=backend run db:sql",
    "build:preview": "npm --workspace=frontend run build:preview",
    "watch:preview": "npm --workspace=frontend run watch:preview"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.6",
    "concurrently": "^10.0.7",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.72.2"
  }
}

{
  "schemaVersion": 1,
  "app": { "name": "Habit Loop", "slug": "habit-loop" },
  "theme": {
    "mode": "light",
    "colors": {
      "primary": "#2F6B4F",
      "onPrimary": "#FFFFFF",
      "background": "#F5F6F2",
      "surface": "#FFFFFF",
      "text": "#17201B",
      "textMuted": "#5A6660",
      "border": "#D5DBD5",
      "success": "#1F8A5B",
      "danger": "#B3322B"
    },
    "radius": "soft"
  },
  "navigation": { "tabs": ["home", "profile"], "initial": "home" },
  "screens": {
    "home": { "title": "Today", "presentation": "tab" },
    "profile": { "title": "Profile", "presentation": "tab" },
    "habitDetail": { "title": "Habit", "presentation": "stack", "params": { "id": "ref:Habit" } },
    "newHabit": { "title": "New habit", "presentation": "modal" }
  },
  "entities": {
    "Habit": {
      "fields": { "title": "string", "target": "int", "note": "string?" },
      "seed": [
        { "id": "habit-1", "title": "Read 20 pages", "target": 7 },
        { "id": "habit-2", "title": "Morning walk", "target": 5, "note": "Before 9am" },
        { "id": "habit-3", "title": "No phone after 10pm", "target": 7 }
      ]
    },
    "Entry": {
      "fields": { "habit": "ref:Habit", "date": "date" },
      "seed": [
        { "id": "entry-1", "habit": "habit-1", "date": "2026-11-14" },
        { "id": "entry-2", "habit": "habit-1", "date": "2026-11-15" },
        { "id": "entry-3", "habit": "habit-1", "date": "2026-11-16" },
        { "id": "entry-4", "habit": "habit-2", "date": "2026-11-16" }
      ]
    }
  }
}
